# Copia este archivo a .env y completa los valores. .env no se sube a git.

# Zona horaria (hora de los mensajes de ntfy)
TZ=America/Bogota

# Primera cámara iCSee: se crea al arrancar si no hay ninguna (y completa las credenciales
# de una instalación anterior). Las demás se agregan desde Configuración en la web.
# Usa una reserva DHCP en el router para fijar la IP de cada cámara.
CAMERA_IP=192.168.1.86
CAMERA_USER=admin
CAMERA_PASSWORD=

# IP del equipo que corre go2rtc (LAN o Tailscale), para los candidatos WebRTC
HOST_IP=192.168.1.10

# Credenciales internas de go2rtc (API y RTSP). Solo letras y números:
# la contraseña va dentro de la URL rtsp://.
GO2RTC_USER=camguard
GO2RTC_PASSWORD=

# Base de CamGuard (Postgres). Solo letras y números: va dentro de la cadena de conexión.
DB_PASSWORD=
# Puerto local (127.0.0.1) de la base, para desarrollo y para migrar desde SQL Server
#DB_DEV_PORT=5433
# Solo para migrar una instalación anterior (SQL Server, hasta el Sprint 5); ver README
#SQL_PASSWORD=

# URL con la que abres la web, sin / final. Abre la web siempre con esta URL:
# Keycloak la usa como issuer de los tokens y para las redirecciones del login.
PUBLIC_URL=http://camguard.tu-tailnet.ts.net:8090
# Puerto del host donde nginx publica la web (debe coincidir con el de PUBLIC_URL)
WEB_PORT=8090

# Keycloak (login). Base de datos propia en Postgres.
KC_DB_PASSWORD=
# Admin de la consola de Keycloak (${PUBLIC_URL}/auth/admin)
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=
# Primer usuario de CamGuard. La contraseña es temporal: se cambia en el primer login.
# Solo se usan al crear el realm la primera vez; después, gestiona usuarios desde la consola.
CAMGUARD_ADMIN_USER=admin
CAMGUARD_ADMIN_EMAIL=
CAMGUARD_ADMIN_PASSWORD=

# SMTP para "¿Olvidaste tu contraseña?". Vacío = sin correos.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=noreply@camguard.local
SMTP_USER=
SMTP_PASSWORD=

# Cloudflare R2 (o cualquier S3-compatible)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=camguard

# ntfy: URL completa del tópico. Vacío = sin notificaciones.
NTFY_URL=https://ntfy.tu-dominio.com/camguard
NTFY_TOKEN=

# Cerraduras Tuya (opcional; ver poc/tuya/README.md). Proyecto Cloud en https://platform.tuya.com
# con la app Tuya Smart vinculada, los servicios IoT Core, IoT Video Live Stream y Smart Lock
# Open Service, y Message Service activado (Device status report). Vacío = sin cerraduras Tuya.
# Endpoints según el data center del proyecto (Western America: tuyaus.com).
TUYA_ENDPOINT=https://openapi.tuyaus.com
TUYA_MESSAGE_ENDPOINT=wss://mqe.tuyaus.com:8285/
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# Information (por defecto) o Debug para registrar todos los mensajes de Tuya al diagnosticar.
TUYA_LOG_LEVEL=Information

# IA que filtra clips sin personas ni animales (opcional). La imagen trae YOLOX-nano; para usar
# yolox_tiny.onnx (más preciso y más lento) cópialo al volumen de datos y apunta aquí, p. ej.
# DETECTION_MODEL_PATH=/data/models/yolox_tiny.onnx. Un archivo inexistente = se sube todo sin analizar.
#DETECTION_MODEL_PATH=/app/models/yolox_nano.onnx
