{
  "plansDirectory": "./.claude/plans",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/move-plan.ps1\"",
            "timeout": 30,
            "statusMessage": "Moviendo el plan a su sprint..."
          }
        ]
      }
    ]
  }
}
