    "MessageEndpoint": "wss://mqe.tuyaus.com:8285/",
    "MessageTopic": "event",
    "ActivationSeconds": 90,
    "StartupGraceSeconds": 90,
    "StatusRefreshMinutes": 360,
    "StreamViaFfmpeg": false
  },
  "Storage": {
    "Endpoint": "",
    "AccessKey": "",
    "SecretKey": "",
