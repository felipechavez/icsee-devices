{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "App": {
    "DataDirectory": "/data",
    "PublicBaseUrl": "http://localhost:8090"
  },
  "Auth": {
    "Authority": "",
    "MetadataAddress": "",
    "Audience": "camguard-api"
  },
  "Camera": {
    "Name": "iCSee",
    "Ip": "",
    "DvripPort": 34567,
    "Go2rtcStream": "icsee",
    "Username": "admin",
    "Password": ""
  },
  "Streams": {
    "SyncSeconds": 30
  },
  "Go2rtc": {
    "BaseUrl": "http://localhost:1984",
    "RtspBaseUrl": "rtsp://localhost:8554"
